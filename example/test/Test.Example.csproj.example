<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>Contoso.Apis.Tests</PackageId>
        <PackageVersion>1.0.0</PackageVersion>
        <Authors>Mielek</Authors>
    </PropertyGroup>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>

        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MSTest" Version="3.11.1"/>
        <PackageReference Include="coverlet.collector" Version="6.0.4"/>
        <PackageReference Include="FluentAssertions" Version="7.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Azure.ApiManagement.PolicyToolkit.Testing" Version="1.0.0"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\source\Source.Example.csproj"/>
    </ItemGroup>

</Project>
